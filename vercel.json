{
  "cleanUrls": true,
  "redirects": [
    { "source": "/projetos/portfolio", "destination": "/projetos", "permanent": true }
  ],
  "rewrites": [
    { "source": "/projetos", "destination": "/index.html" },
    { "source": "/projetos/:slug", "destination": "/index.html" },
    { "source": "/inspiracoes", "destination": "/index.html" },
    { "source": "/oficina", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ]
}
